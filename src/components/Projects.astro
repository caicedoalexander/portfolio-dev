---
import GitHub from "./icons/Github.astro"
import Link from "./icons/Link.astro"
import CakePHP from "./icons/CakePHP.astro"
import Bootstrap from "./icons/Boostrap.astro"
import MySql from "./icons/MySql.astro"
import PHP from "./icons/PHP.astro"
import Wordpress from "./icons/Wordpress.astro"
import Javascript from "./icons/Javascript.astro"
import N8n from "./icons/n8n.astro"
import TypeScript from "./icons/TypeScript.astro"
import NodeJs from "./icons/NodeJs.astro"
import Claude from "./icons/Claude.astro"

const TAGS = {
  BOOSTRAP: {
    name: "Bootstrap 5",
    color: "#8312FA",
    icon: Bootstrap,
  },
  CAKEPHP: {
    name: "CakePHP",
    color: "#D33C43",
    icon: CakePHP,
  },
  MYSQL: {
    name: "MySQL",
    color: "#4479A1",
    icon: MySql,
  },
  PHP: {
    name: "PHP 8.1+",
    color: "#777BB4",
    icon: PHP,
  },
  WORDPRESS: {
    name: "WordPress",
    color: "#21759B",
    icon: Wordpress,
  },
  JAVASCRIPT: {
    name: "JavaScript",
    color: "#F7DF1E",
    icon: Javascript,
  },
  N8N: {
    name: "n8n",
    color: "#EA4B71",
    icon: N8n,
  },
  TYPESCRIPT: {
    name: "TypeScript",
    color: "#3178C6",
    icon: TypeScript,
  },
  NODEJS: {
    name: "Node.js",
    color: "#5FA04E",
    icon: NodeJs,
  },
  CLAUDE_CODE: {
    name: "Claude Code",
    color: "#D97757",
    icon: Claude,
  },
  MCP: {
    name: "MCP",
    color: "#10B981",
  },
}

const PROJECTS = [
  {
    title: "Sistema de gestión Interna",
    description:
      "Centraliza la operación administrativa de una empresa: más de 15 personas gestionan facturas, anticipos, caja menor, hojas de vida del personal, permisos y novedades de nómina en un solo lugar. Cada documento recorre un flujo de aprobación según el cargo de quien lo revisa, se puede aprobar desde el correo y queda registro de quién cambió qué y cuándo. Incluye cruce automático de facturas contra la DIAN.",
    link: 'https://sgi.alexandercaicedo.dev/',
    image: "/projects/sgi.png",
    tags: [TAGS.CAKEPHP, TAGS.PHP, TAGS.MYSQL, TAGS.N8N],
  },
  {
    title: "Mesa de Ayuda",
    description:
      "Los correos y mensajes de WhatsApp que llegan a soporte se convierten solos en tickets, con responsable, historial y seguimiento. Nada se queda perdido en una bandeja de entrada: el equipo recibe el aviso por el canal que corresponda y cada cambio queda registrado. Construida para seguir funcionando aunque una integración externa falle.",
    link: 'https://mesadeayuda.alexandercaicedo.dev/',
    image: "/projects/mesa-de-ayuda.png",
    tags: [TAGS.CAKEPHP, TAGS.BOOSTRAP, TAGS.MYSQL, TAGS.N8N],
  },
  {
    title: "OpenSEO",
    description:
      "Plugin de WordPress open source para SEO asistido por IA. Arquitectura BYO Provider (OpenAI, Anthropic, Gemini, Ollama) y skills editables mediante plantillas de prompt con variables. PSR-4, registro extensible por filtros y pago directo al proveedor.",
    github: 'https://github.com/openseo-wp/openseo',
    image: "/projects/openseo.png",
    tags: [TAGS.WORDPRESS, TAGS.PHP, TAGS.JAVASCRIPT],
  },
  {
    title: "opencode-delegate",
    description:
      "Permite que Claude Code reparta el trabajo repetitivo —buscar entre cientos de archivos, generar código de plantilla, escribir pruebas rutinarias— entre modelos externos, mientras conserva la dirección de la tarea. Cada encargo corre aislado, así que nada toca tu código sin que lo revises antes.",
    github: 'https://github.com/caicedoalexander/opencode-delegate',
    image: "/projects/opencode-delegate.png",
    tags: [TAGS.TYPESCRIPT, TAGS.NODEJS, TAGS.MCP, TAGS.CLAUDE_CODE],
  },
]
---
  
<div class="grid gap-8">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }, index) => (
    <article class={`group relative reveal stagger-${index + 1}`}>
      <!-- Diagonal Accent Line -->
      <div
        class="absolute -left-4 top-0 bottom-0 w-1 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500"
        style="background: linear-gradient(to bottom, var(--color-accent-creative), transparent);"
      ></div>

      <div class="grid md:grid-cols-2 gap-8 items-center">
        <!-- Image -->
        <div class="relative overflow-hidden rounded-xl aspect-video" style="background-color: var(--color-bg-elevated)">
          <div
            class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
            style="background: linear-gradient(to bottom right, rgba(236, 72, 153, 0.2), transparent);"
          ></div>
          <img
            alt={title}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
            loading="lazy"
            src={image}
          />
        </div>

        <!-- Content -->
        <div>
          <h3 class="project-title text-3xl font-bold mb-3 transition-colors" style="font-family: var(--font-display)">
            {title}
          </h3>

          <!-- Tags -->
          <div class="flex flex-wrap gap-2 mb-4">
            {tags.map((tag) => (
              <span
                class="inline-flex items-center gap-2 px-3 py-1 text-xs font-bold rounded-full transition-all hover:scale-105"
                style={`color: ${tag.color}; background-color: var(--color-bg-elevated); border: 1px solid var(--color-border);`}
              >
                {tag.icon && <tag.icon class="size-4" />}
                {tag.name}
              </span>
            ))}
          </div>

          <p class="mb-6 leading-relaxed" style="color: var(--color-text-secondary)">{description}</p>

          <!-- Actions -->
          <div class="flex flex-wrap gap-3">
            {github && (
              <a
                href={github}
                target="_blank"
                rel="noopener"
                class="project-btn-secondary inline-flex items-center gap-2 px-4 py-2 rounded-lg font-bold transition-all hover:scale-105 hover:shadow-lg"
              >
                <GitHub class="size-5" />
                <span>Código</span>
              </a>
            )}
            {link && (
              <a
                href={link}
                target="_blank"
                rel="noopener"
                class="project-btn-primary inline-flex items-center gap-2 px-4 py-2 text-white rounded-lg font-bold transition-all hover:scale-105 hover:shadow-lg"
              >
                <Link class="size-4" />
                <span>Ver Proyecto</span>
              </a>
            )}
          </div>
        </div>
      </div>
    </article>
    ))
  }
</div>

<style>
  .project-title {
    color: var(--color-text);
  }

  .group:hover .project-title {
    color: var(--color-accent-creative);
  }

  .project-btn-secondary {
    background-color: var(--color-bg-elevated);
    border: 2px solid var(--color-border);
  }

  .project-btn-secondary:hover {
    border-color: var(--color-text);
  }

  .project-btn-primary {
    background-color: var(--color-accent-creative);
  }

  .project-btn-primary:hover {
    box-shadow: 0 20px 25px -5px rgba(236, 72, 153, 0.25);
  }
</style>